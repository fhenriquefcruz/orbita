# Nunca compartilhe este arquivo preenchido nem envie ao GitHub.
# Primeiro REVOQUE o token anterior pelo BotFather e use SOMENTE o novo.
TELEGRAM_BOT_TOKEN=COLE_AQUI_O_NOVO_TOKEN_PRIVADO
# Comece com 0, envie /id ao bot, depois preencha seu ID e reinicie.
ORBITA_OWNER_ID=0
# Opcional: habilita respostas em linguagem natural (cobrança API separada)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Memória central OPCIONAL: configurar OS TRÊS juntos ou nenhum.
# Use projeto Supabase exclusivo, tabela com RLS e conta Auth criada.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
ORBITA_USER_UUID=

# ATIVAR SOMENTE após executar a migração 002 e homologar no projeto ORBITA.
# Em Supabase, permanece desligado quando ausente/0. SQLite local mantém prévias.
ORBITA_NATURAL_ACTIONS_ENABLED=0

# Entrega verificável de respostas do webhook (somente após SQL 003 + testes reais).
# Desativado por padrão. Não usar no polling; somente webhook.
ORBITA_WEBHOOK_DELIVERY_V2_ENABLED=0
